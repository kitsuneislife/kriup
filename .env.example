DATABASE_URL=postgres://app:app@localhost:5433/app
# Public origin used in e-mail links.
APP_URL=http://localhost:5173
# Secret the payment provider sends on every webhook (header x-webhook-token while simulated).
PAYMENT_WEBHOOK_TOKEN=dev-webhook-token
# Bearer token for POST /api/jobs/daily.
JOBS_TOKEN=dev-jobs-token

# Optional real payment provider (Asaas); leave unset to use the simulated gateway.
# ASAAS_API_KEY=
# ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# Optional transactional e-mail provider (Resend); leave unset to log e-mails locally.
# RESEND_API_KEY=
# EMAIL_FROM=Cakto <noreply@example.com>
